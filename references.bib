	journal = {International Journal of Applied Electromagnetics and Mechanics},
	number = {3},
	pages = {1081-1086},
	title = {Safety assessment of displacement force, torque and vibration of a deep brain stimulation system under 3T MRI},
	url = {https://doi.org/10.3233/JAE-171084},
	volume = {59},
	year = {2019},
	bdsk-url-1 = {https://doi.org/10.3233/JAE-171084}}

