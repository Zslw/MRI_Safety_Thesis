@article{zhang2019,
	abstract = { Deep brain stimulation (DBS) is an effective therapy for treating neurological disorders, while magnetic resonance imaging (MRI) is a valuable method for clinical diagnosis and research. However, DBS systems in clinical MRI are under the influence of displacement force, torque and device vibration, which may be hazardous to patients after DBS implantation surgery. In this study, we evaluated these hazardous effects under 3T MRI. A set of apparatus were designed and built and the corresponding methods for safety assessment were also proposed. Results showed that the displacement force, torque and vibration of the DBS system under 3T MRI were safe. Furthermore, this study demonstrates an example of an MRI compatibility test that can be applied to many other medical instruments. },
	author = {Feng Zhang and Changqing Jiang and Xiaolong Mo and Yinghua Liu and Huimin Xie and Luming Li},
	date-added = {2025-11-03 15:50:36 -0600},
	date-modified = {2025-11-03 15:50:52 -0600},
	doi = {10.3233/JAE-171084},
